# Local UniFi OS console hostname or IP; no scheme or path.
UDM_HOST=
# Generate in UniFi Network > Settings > Control Plane > Integrations.
UNIFI_API_KEY=
# Keep false for self-signed local certificates only when necessary.
UNIFI_VERIFY_TLS=false
# Optional site UUID/name; discovery is preferred.
UNIFI_SITE=
# Live writes remain disabled unless set to the exact documented phrase.
UNIFI_ENABLE_WRITES=disabled
