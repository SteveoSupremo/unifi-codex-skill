# Local UniFi OS console hostname or IP; no scheme or path.
UDM_HOST=
# Generate in UniFi Network > Settings > Control Plane > Integrations.
UNIFI_API_KEY=
# Keep false for self-signed local certificates only when necessary.
UNIFI_VERIFY_TLS=false
# Optional site UUID/name; discovery is preferred.
UNIFI_SITE=
# Necessary but not sufficient: every live operation also needs its exact --approve token.
UNIFI_ENABLE_WRITES=disabled

# Optional read-only MCP server (install requirements-mcp.txt).
# Generate privately with: python3 scripts/mcp_token.py
UNIFI_MCP_TOKEN=
# Native startup defaults to localhost. Compose uses its private container IP.
UNIFI_MCP_BIND=127.0.0.1
# Extra exact HTTP Host values, comma-separated, only if using a different URL.
UNIFI_MCP_ALLOWED_HOSTS=
# Existing Open WebUI Docker network; no host ports are published.
UNIFI_MCP_DOCKER_NETWORK=open-webui_default
UNIFI_MCP_UID=1000
UNIFI_MCP_GID=1000
